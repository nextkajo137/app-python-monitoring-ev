# Base URL Node-RED. Jika Node-RED belum aktif, Flask otomatis memakai dummy simulator lokal.
NODE_RED_BASE_URL=http://127.0.0.1:1880

# Tarif dummy PLN dalam Rupiah per kWh. Bisa diganti sesuai kebutuhan.
TARIFF_RP_PER_KWH=1444.70

# Mode fallback simulator lokal: true/false
LOCAL_DUMMY_FALLBACK=true

# Flask host/port
APP_HOST=0.0.0.0
APP_PORT=5000